        },
        {
          "info": {
            "name": "Returns a CSV of the latest frxUSD balance sheet data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.frax.finance/v2/frxusd/balance-sheet/latest/export"
          },
